# Copy this file to .env.local and fill it in.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Site ─────────────────────────────────────────────────────
# Feeds metadataBase, canonical URLs, the sitemap, robots.txt and OG images.
NEXT_PUBLIC_SITE_URL=https://your-real-domain.com

# ── Supabase ─────────────────────────────────────────────────
# Dashboard → Project Settings → Data API (URL) and API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SERVICE ROLE key — bypasses row level security. SERVER ONLY.
# Never prefix this with NEXT_PUBLIC_, never paste it into client code,
# and never commit .env.local. If it leaks, rotate it immediately in
# Dashboard → Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key. Safe to expose — it is shipped in client JS.
# Not needed until Phase 5 (realtime client area); leave blank for now.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin ────────────────────────────────────────────────────
# NOTE: NEXT_PUBLIC_ vars are bundled into client JS and visible to anyone
# who inspects the page. This one only gates the local content editor at
# /admin, which edits your own browser copy — convenience, not security.
# The Phase 4 lead admin will use a real server-side guard instead.
NEXT_PUBLIC_ADMIN_PASSWORD=change-me-halek
